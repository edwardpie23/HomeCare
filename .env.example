# ============================================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# ============================================================

# Database — SQLite, no changes needed for local dev
DATABASE_URL="file:./prisma/dev.db"

# NextAuth — required for login/register to work
NEXTAUTH_URL="http://localhost:3000"
# Generate a secret: run this in your terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_STRING"

# ============================================================
# ANTHROPIC (required for AI photo estimates)
# Get your key at: https://console.anthropic.com
# ============================================================
ANTHROPIC_API_KEY="sk-ant-REPLACE_WITH_YOUR_KEY"

# ============================================================
# STRIPE (optional for basic testing — skip for now)
# The app works without Stripe; subscription button just won't work
# Get keys at: https://dashboard.stripe.com/test/apikeys
# ============================================================
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
STRIPE_SUBSCRIPTION_PRICE_ID="price_placeholder"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"

# ============================================================
# RESEND (optional — for email notifications)
# Get your key at: https://resend.com
# Without this key, emails are silently skipped (no errors)
# ============================================================
RESEND_API_KEY="re_REPLACE_WITH_YOUR_KEY"
