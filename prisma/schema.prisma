generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("customer")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  jobRequests   JobRequest[]
  contractor    Contractor?
  bookings      Booking[]
  reviews       Review[]
  sentMessages  Message[]      @relation("MessageSender")
  notifications Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Contractor {
  id                 String    @id @default(cuid())
  userId             String    @unique
  businessName       String
  phone              String?
  address            String?
  city               String?
  state              String?
  zipCode            String?
  bio                String?
  licenseNumber      String?
  specialties        String    @default("[]")
  yearsExperience    Int       @default(0)
  rating             Float     @default(0)
  reviewCount        Int       @default(0)
  isVerified         Boolean   @default(false)
  isActive           Boolean   @default(true)
  subscriptionStatus String    @default("inactive")
  subscriptionEnds   DateTime?
  stripeCustomerId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  pricingRules     PricingRule[]
  bookings         Booking[]
  estimates        Estimate[]
  builderEstimates ContractorEstimate[]
  reviews          Review[]
}

model ContractorEstimate {
  id              String   @id @default(cuid())
  contractorId    String
  estimateNumber  String
  status          String   @default("draft") // draft | sent | accepted | declined

  // Customer
  customerName    String?
  customerEmail   String?
  customerAddress String?

  // Project
  categoryId      String?
  projectTitle    String?
  description     String?
  size            Float?
  city            String?
  state           String?
  urgency         String   @default("flexible")

  // Pricing
  lineItems       String   @default("[]") // JSON array of {id,item,cost,category}
  minPrice        Float?
  maxPrice        Float?
  totalPrice      Float?
  taxRate         Float    @default(0)
  discount        Float    @default(0)
  estimatedDays   Int?
  validDays       Int      @default(30)

  // Notes & terms
  terms           String?
  notes           String?
  internalNotes   String?

  // Materials list (internal only — not sent to customer)
  materialsList   String?  // JSON array of {item,qty,unit,unitCost,total}

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
}

model JobCategory {
  id           String  @id @default(cuid())
  name         String  @unique
  description  String?
  icon         String?
  baseMinPrice Float
  baseMaxPrice Float
  unit         String  @default("job")

  jobRequests  JobRequest[]
  pricingRules PricingRule[]
}

model JobRequest {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  title       String
  description String?
  photos      String   @default("[]")
  address     String?
  city        String
  state       String
  zipCode     String
  size        Float?
  urgency     String   @default("flexible")
  aiAnalysis  String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  JobCategory @relation(fields: [categoryId], references: [id])
  estimates Estimate[]
  booking   Booking?
}

model Estimate {
  id           String    @id @default(cuid())
  jobRequestId String
  contractorId String?
  minPrice     Float
  maxPrice     Float
  avgPrice     Float
  breakdown    String?
  notes        String?
  validUntil   DateTime?
  isAiGenerated Boolean  @default(false)
  status       String    @default("pending") // pending | accepted | declined
  createdAt    DateTime  @default(now())

  jobRequest JobRequest  @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  contractor Contractor? @relation(fields: [contractorId], references: [id])
}

model PricingRule {
  id           String  @id @default(cuid())
  contractorId String
  categoryId   String
  basePrice    Float
  pricePerUnit Float?
  unit         String?
  notes        String?

  contractor Contractor  @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  category   JobCategory @relation(fields: [categoryId], references: [id])

  @@unique([contractorId, categoryId])
}

model Booking {
  id              String    @id @default(cuid())
  jobRequestId    String    @unique
  customerId      String
  contractorId    String
  scheduledDate   DateTime?
  agreedPrice     Float
  status          String    @default("pending")
  leadFee         Float     @default(15)
  leadFeePaid     Boolean   @default(false)
  stripePaymentId String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id])
  customer   User       @relation(fields: [customerId], references: [id])
  contractor Contractor @relation(fields: [contractorId], references: [id])
  review     Review?
  messages   Message[]
}

model Message {
  id         String   @id @default(cuid())
  bookingId  String
  senderId   String
  senderRole String   // customer | contractor
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User    @relation("MessageSender", fields: [senderId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // quote_received | quote_accepted | message | review | status_update
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  contractorId String
  customerId   String
  rating       Int      // 1-5
  comment      String?
  createdAt    DateTime @default(now())

  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  contractor Contractor @relation(fields: [contractorId], references: [id])
  customer   User       @relation(fields: [customerId], references: [id])
}
